APP_NAME="Apogee Shop"
APP_ENV=local
APP_DEBUG=true
APP_KEY=
APP_URL=http://localhost:8000

DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite

CACHE_STORE=file
QUEUE_CONNECTION=database
SESSION_DRIVER=file
MAIL_MAILER=log
MAIL_FROM_ADDRESS=shop@example.com

# With Redis: CACHE_STORE=redis QUEUE_CONNECTION=redis SESSION_DRIVER=redis
REDIS_URL=redis://127.0.0.1:6379/0
LOG_CHANNEL=stack
LOG_LEVEL=debug
