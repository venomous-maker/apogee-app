APP_NAME="Apogee Shop"
APP_ENV=local
APP_DEBUG=true
APP_KEY=
APP_URL=http://localhost:8000

DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite

CACHE_STORE=file
QUEUE_CONNECTION=database
SESSION_DRIVER=file
MAIL_MAILER=log
MAIL_FROM_ADDRESS=shop@example.com

# With Redis: CACHE_STORE=redis QUEUE_CONNECTION=redis SESSION_DRIVER=redis
REDIS_URL=redis://127.0.0.1:6379/0
LOG_CHANNEL=stack
LOG_LEVEL=debug

# Files: the local disk (storage/app); S3 when a bucket is set
FILESYSTEM_DISK=local
# AWS_BUCKET= AWS_DEFAULT_REGION=us-east-1 AWS_ACCESS_KEY_ID= AWS_SECRET_ACCESS_KEY= AWS_ENDPOINT=

# Search: database (full-text in the app's database), meilisearch or memory
SCOUT_DRIVER=database
# MEILISEARCH_HOST=http://127.0.0.1:7700 MEILISEARCH_KEY=

# Feature flags: database, cache or memory
FEATURES_STORE=database

# Broadcasting: null, log or sockets (run ./apogee-app sockets:serve)
BROADCAST_CONNECTION=null
SOCKETS_URL=http://127.0.0.1:6001
SOCKETS_APP_ID=apogee-shop
SOCKETS_APP_KEY=apogee-shop-key
SOCKETS_APP_SECRET=

# Dashboards: Telescope is on locally; Pulse and the queue's are opt in
# (outside local, admins only)
TELESCOPE_ENABLED=true
PULSE_ENABLED=false
QUEUE_DASHBOARD_ENABLED=false

# Social sign-in at /auth/<provider>: set a client id and secret to turn one on
# (GOOGLE_, MICROSOFT_ (and MICROSOFT_TENANT), GITLAB_, DISCORD_, SLACK_, LINKEDIN_,
# FACEBOOK_, BITBUCKET_, or OIDC_ with OIDC_ISSUER)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
