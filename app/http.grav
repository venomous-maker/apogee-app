// http.grav — the shop over HTTP: controllers (pages, sign-up and sign-in,
// products as a resource, checkout, the JSON API), form requests, an API
// resource, a middleware, and the policy that guards products.
import "std"
import "apogee-framework"
import "models.grav"
import "domain.grav"

namespace app {

    // ── form requests ────────────────────────────────────────────────────────
    class RegisterRequest extends FormRequest {
        fn rules() -> HashMap<string, any> {
            return {
                "name": "required|string|max:80", "email": ["required", "email", Rule.unique("users", "email")],
                "password": ["required", "confirmed", Password.min(8).letters().numbers()]
            };
        }
        fn messages() -> HashMap<string, string> {
            return {"email.unique": "That email already has an account."};
        }
        fn prepareForValidation() {
            self.merge({"email": Str.lower(Str.trim(self.string("email")))});
        }
    }
    class StoreProductRequest extends FormRequest {
        fn authorize() -> bool {
            return self.user != null && (self.user as User).isAdmin();
        }
        fn rules() -> HashMap<string, any> {
            return {"name": "required|string|max:120", "description": "required|string|min:10", "price": "required|integer|min:1", "stock": "required|integer|between:0,10000"};
        }
        fn attributes() -> HashMap<string, string> {
            return {"price": "price (in cents)"};
        }
    }
    class PlaceOrderRequest extends FormRequest {
        fn authorize() -> bool {
            return self.user != null;
        }
        fn rules() -> HashMap<string, any> {
            return {"items": "required|array|min:1|max:20", "items.*.slug": "required|string|distinct|exists:products,slug", "items.*.quantity": "required|integer|between:1,10"};
        }
        fn after(v: Validator) {
            for (item in self.list("items")) {
                let m = item as HashMap<string, any>;
                let p = Product.query().firstWhere("slug", m["slug"]);
                if (p != null && p.stock < Integer.parseOr(str(m["quantity"]), 0)) { v.addError("items", "Only ${p.stock} of " + p.name + " left."); }
            }
        }
    }

    // ── API resource ─────────────────────────────────────────────────────────
    class ProductResource extends JsonResource {
        constructor(p: any = null) {
            super(p);
        }
        fn toArray(req: Request) -> HashMap<string, any> {
            let p = self.resource as Product;
            return self.fields().add("slug", p.slug).add("name", p.name).add("price", p.price).add("price_text", p.priceText())
                .add("in_stock", p.inStock())
                .when(req.user != null && (req.user as User).isAdmin(), "stock", p.stock)
                .build();
        }
    }

    // ── middleware ───────────────────────────────────────────────────────────
    // Times every request and says so in a header (and the log, when slow).
    class TimeRequests implements Middleware {
        private log: LogChannel
        constructor(log: LogChannel) {
            self.log = log;
        }
        fn handle(req: Request, next: fn(Request) -> Response) -> Response {
            let sw = new Stopwatch();
            let res = next(req);
            let ms = sw.elapsedMs();
            if (ms > 500) { self.log.warning("slow request", fields("path", req.path(), "ms", ms)); }
            return res.header("X-Response-Time", "${ms}ms");
        }
    }

    // ── policy ───────────────────────────────────────────────────────────────
    class ProductPolicy extends Policy {
        constructor() {}
        fn before(user: any, ability: string) -> bool? {
            return user != null && (user as User).isAdmin() ? true : null;
        }
        @Guests fn view(user: User, product: Product) -> bool {
            return true;
        }
        fn update(user: User, product: Product) -> bool {
            return user.id == product.userId;
        }
        fn delete(user: User, product: Product) -> Decision {
            return user.id == product.userId ? Decision.allow() : Decision.denyAsNotFound();
        }
    }

    // ── controllers ──────────────────────────────────────────────────────────
    class HomeController extends Controller {
        private views: ViewFactory
        private cache: CacheRepository
        constructor(views: ViewFactory, cache: CacheRepository) {
            self.views = views
            self.cache = cache
        }
        fn index(req: Request) -> Response {
            // (the front page's products come from the cache for a minute)
            let featured = self.cache.remember("home:featured", 60, fn() -> any {
                let list = new Array<any>();
                for (p in Product.query().where("stock", ">", 0).orderBy("price", "desc").limit(4).get()) { list.push(p.slug); }
                return list;
            }) as Array<any>;
            let products = new Array<any>();
            for (slug in featured) { products.push(Product.query().firstWhere("slug", slug) as any); }
            return self.views.response(req, "home", {"products": products, "today": Moment.now().format("l, jS F Y")});
        }
    }

    // Signing in with GitHub, Google… (each provider with a client id in .env):
    // the account with that email, or a new one.
    class SocialController extends Controller {
        private auth: AuthManager
        constructor(auth: AuthManager) {
            self.auth = auth;
        }
        fn redirect(req: Request) -> Response {
            let provider = str(req.route("provider"));
            if (!Socialite.has(provider)) { throw new HttpException(404); }
            return Socialite.driver(provider).redirect(req);
        }
        fn callback(req: Request) -> Response {
            let provider = str(req.route("provider"));
            if (!Socialite.has(provider)) { throw new HttpException(404); }
            let who: SocialUser = null;
            try { who = Socialite.driver(provider).user(req); }
            catch (e: InvalidStateException) { return Response.redirect("/login"); }
            catch (e: OAuthException) { return Response.redirect("/login"); }
            // (only an address the provider vouches for may sign in to an account that has it)
            if (who.email == "" || !who.emailVerified) {
                throw ValidationException.withMessages({"email": ["Your " + provider + " account has no verified email address."]});
            }
            let email = Str.lower(who.email);
            let u = User.query().firstWhere("email", email) as User;
            if (u == null) {
                u = User.create(fields("name", who.name != "" ? who.name : who.nickname, "email", email, "password", Passwords.make(Hash.randomToken(24))));
            }
            self.auth.session().login(req, u);
            return AuthManager.attachCookies(req, Response.redirect("/"));
        }
    }

    class AuthController extends Controller {
        private auth: AuthManager
        private views: ViewFactory
        constructor(auth: AuthManager, views: ViewFactory) {
            self.auth = auth
            self.views = views
        }
        fn showRegister(req: Request) -> Response {
            return self.views.response(req, "auth.register");
        }
        fn register(req: RegisterRequest, mail: Mailer, events: Events) -> Response {
            let data = req.validated();
            let u = User.create(fields("name", data["name"], "email", data["email"], "password", Passwords.make(str(data["password"]))));
            self.auth.session().login(req, u);
            mail.to(u.email, u.name).queue(new WelcomeMail(u.name));
            events.fire("app.registered", u.email);
            (req.session as Session).flash("status", "Welcome, " + u.name + "!");
            return Response.redirect("/");
        }
        fn showLogin(req: Request) -> Response {
            return self.views.response(req, "auth.login");
        }
        fn login(req: Request, limiter: CacheRepository) -> Response {
            req.validate({"email": "required|email", "password": "required"});
            let key = "login:" + Str.lower(req.string("email")) + "|" + req.ip();
            let limits = limiter.limiter();
            if (limits.tooManyAttempts(key, 5)) {
                throw ValidationException.withMessages({"email": ["Too many attempts. Try again in ${limits.availableIn(key)} seconds."]});
            }
            if (!self.auth.session().attempt(req, {"email": Str.lower(req.string("email")), "password": req.string("password")}, req.boolean("remember"))) {
                limits.hit(key, 60);
                throw ValidationException.withMessages({"email": ["These credentials do not match our records."]});
            }
            limits.clear(key);
            return AuthManager.attachCookies(req, Response.redirect("/"));
        }
        fn logout(req: Request) -> Response {
            self.auth.session().logout(req);
            return AuthManager.attachCookies(req, Response.redirect("/"));
        }
        // A token for the JSON API (shown once).
        fn token(req: Request, users: OrbitUserProvider) -> any {
            return {"token": users.issueApiToken(req.user)};
        }
    }

    class ProductController extends Controller {
        private views: ViewFactory
        constructor(views: ViewFactory) {
            self.views = views;
        }
        fn index(req: Request) -> Response {
            let page = Product.query().orderBy("name").paginate(req.integer("page", 1), 6);
            return self.views.response(req, "products.index", {"products": page.items, "page": page.page, "pages": page.lastPage()});
        }
        fn show(req: Request, product: Product) -> Response {
            return self.views.response(req, "products.show", {"product": product});
        }
        fn store(req: StoreProductRequest, queue: QueueManager) -> Response {
            let data = req.validated();
            let p = Product.create(fields("name", data["name"], "slug", Text.slug(str(data["name"])), "description", data["description"],
                                          "price", data["price"], "stock", data["stock"], "userId", (req.user as User).id));
            queue.dispatch(new RebuildSearchIndex());
            return Response.redirect("/products/" + p.slug);
        }
        fn update(req: Request, product: Product, gate: Gate) -> Response {
            gate.authorize(req.user, "update", [product as any]);
            let data = req.validate({"price": "sometimes|integer|min:1", "stock": "sometimes|integer|min:0"});
            if (data.containsKey("price")) { product.price = Integer.parseOr(str(data["price"]), product.price); }
            if (data.containsKey("stock")) { product.stock = Integer.parseOr(str(data["stock"]), product.stock); }
            product.save();
            return Response.json({"slug": product.slug, "price": product.price, "stock": product.stock});
        }
        fn destroy(req: Request, product: Product, gate: Gate) -> Response {
            gate.authorize(req.user, "delete", [product as any]);
            product.delete();
            return Response.noContent();
        }
    }

    class OrderController extends Controller {
        constructor() {}
        fn store(req: PlaceOrderRequest, events: Events, queue: QueueManager) -> Response {
            let user = req.user as User;
            let made = new Array<Order>();                 // (a closure cannot assign a captured local)
            DB.transaction(fn() {
                let o = Order.create(fields("userId", user.id, "number", "ORD-" + Text.upper(Text.random(8)), "status", "placed", "total", 0));
                let total = 0 as long;
                for (item in req.list("items")) {
                    let m = item as HashMap<string, any>;
                    let p = Product.query().firstWhere("slug", m["slug"]);
                    let qty = Integer.parseOr(str(m["quantity"]), 1);
                    OrderItem.create(fields("orderId", o.id, "productId", p.id, "quantity", qty, "price", p.price));
                    total += qty * p.price;
                }
                o.total = total;
                o.save();
                made.push(o);
            });
            let order = made[0];
            events.dispatch(new OrderPlaced(order));
            queue.chain([new GenerateInvoice(order) as Job, new NotifyWarehouse(order.number)]).onQueue("orders").dispatch();
            return Response.created({"number": order.number, "total": order.total, "total_text": order.totalText()}, "/orders/" + order.number);
        }
    }

    // The JSON API (under /api, token auth, throttled).
    class ApiProductController extends Controller {
        constructor() {}
        fn index(req: Request) -> Response {
            let all = collect(Product.query().orderBy("name").get())
                .when(req.filled("q"), fn(c: Collection<Product>) -> Collection<Product> {
                let q = Str.lower(req.string("q"));
                return c.filter(fn(p: Product) -> bool { return Str.contains(Str.lower(p.name), q); });
            })
                .when(req.boolean("in_stock"), fn(c: Collection<Product>) -> Collection<Product> { return c.filter(fn(p: Product) -> bool { return p.inStock(); }); });
            let list = new Array<any>();
            for (p in all.all()) { list.push(p as any); }
            let page = Paginator.slice(list, req.integer("per_page", 5) as int, req.integer("page", 1) as int, "/api/products");
            return ResourceCollection.paged(page, fn(x: any) -> JsonResource { return new ProductResource(x); }).toResponse(req);
        }
        fn show(req: Request, product: Product) -> Response {
            return new ProductResource(product).toResponse(req);
        }
        // Full-text search (Scout): ?q=, &in_stock=1.
        fn search(req: Request) -> Response {
            let s = Scout.search::<Product>(req.string("q"));
            if (req.boolean("in_stock")) { s = s.where("in_stock", true); }
            let list = new Array<any>();
            for (p in s.take(req.integer("limit", 10) as int).get()) { list.push(p as any); }
            return ResourceCollection.of(list, fn(x: any) -> JsonResource { return new ProductResource(x); }).toResponse(req);
        }
        fn stats(req: Request) -> any {
            let products = collect(Product.all());
            return {
                "count": products.count(), "stock": products.sumOf("stock"), "average_price": Number.format(products.avg(fn(p: Product) -> double { return (p.price as double) / 100.0; }), 2),
                "most_stocked": products.maxBy(fn(p: Product) -> double { return p.stock as double; }).slug,
                "by_letter": products.countBy(fn(p: Product) -> string { return Str.upper(p.name[..1]); })
            };
        }
    }
}
